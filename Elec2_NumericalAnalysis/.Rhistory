error_bounds <- function(formula, values, errors) {
values <- as.list(values)
errors <- as.list(errors)
actual <- do.call(formula, values)
partial <- function(name) {
x <- values[[name]]
step <- max(abs(x), 1) * .Machine$double.eps^(1 / 3)
hi <- values; hi[[name]] <- x + step
lo <- values; lo[[name]] <- x - step
(do.call(formula, hi) - do.call(formula, lo)) / (2 * step)
}
error <- sum(sapply(names(values), function(n) abs(partial(n)) * errors[[n]]))
list(actual = actual, error = error)
}
# --- Example from the problem set ---------------------------------------
if (sys.nframe() == 0) {
epsilon <- function(F, h, E) F / (h^2 * E)
res <- error_bounds(
epsilon,
values = list(F = 72,  h = 0.004, E = 70e9),
errors = list(F = 0.9, h = 0.0001, E = 1.5e9)
)
cat(sprintf("e_actual = %.9f\n", res$actual))
cat(sprintf("e_error  = %.10f\n", res$error))
cat(sprintf("range    = [%.10f, %.10f]\n",
res$actual - res$error, res$actual + res$error))
}
